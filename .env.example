API_MOBILE=
API_PASSWORD=
MONGO_URI=
# Optional default when using the legacy one-step /upload endpoint
TS_UUID=
TEST_UUID=
# Optional protection for the Attendance Reports module, if enabled later.
APP_USER=
APP_PASSWORD=
# Student AI Agent (optional). Without a key the agent uses the built-in keyword matcher.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
DATABASE_URL=
# Login (required on Vercel — never commit the real value; this repo is public)
APP_PASSWORD=
# Optional: only these staff mobiles may sign in (comma-separated). Empty = any valid mobile.
ALLOWED_MOBILES=
# Optional: session signing key (a random long string). Derived from other secrets if empty.
FLASK_SECRET_KEY=
# AI for the Student AI Agent — any ONE of these (checked in this order):
#   ANTHROPIC_API_KEY   Claude directly
#   AI_GATEWAY_API_KEY  Vercel AI Gateway (on Vercel, the automatic OIDC token is used even without this)
#   OPENAI_API_KEY      OpenAI
# AI_MODEL           optional model override (gateway default: anthropic/claude-sonnet-5.5)
# AI_PROVIDER=off    disable the automatic Vercel AI Gateway connection
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
